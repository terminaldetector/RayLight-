+static abaddon::Vec3 AbaddonOffset( const Vector &vec )
+{
+	return abaddon::Vec3( vec.x, vec.y, vec.z );
+}
+
+static bool AbaddonClearance( const Vector &start, const Vector &end, float radius, CHL2_Player *pilot )
+{
+	trace_t trace;
+	const Vector extents( radius, radius, radius );
+	UTIL_TraceHull( start, end, -extents, extents, MASK_SHOT_HULL, pilot, COLLISION_GROUP_NONE, &trace );
+	return !trace.DidHit();
+}
+
+void CHL2_Player::ResetAbaddonMineBay()
+{
+	m_bAbaddonMineBayInitialized = true;
+	m_nAbaddonMines = abaddon::InitialMines;
+	m_bAbaddonGravityMine = false;
+	m_flAbaddonMineReady = 0.0f;
+}
+
+bool CHL2_Player::RefillAbaddonMines()
+{
+	const abaddon::MineFeed bay = {m_nAbaddonMines.Get(), m_flAbaddonMineReady};
+	const int next = bay.Restock();
+	if ( next == bay.reserve )
+		return false;
+	m_nAbaddonMines = next;
+	EmitSound( "HL2Player.PickupWeapon" );
+	return true;
+}
+
+CON_COMMAND( abaddon_mine_set, "Select the fifth bay payload: plasma or gravity" )
+{
+	CHL2_Player *pilot = dynamic_cast<CHL2_Player *>( UTIL_GetCommandClient() );
+	if ( !pilot || !pilot->IsAbaddonFlightEnabled() || !pilot->CanAbaddonFly() )
+		return;
+	if ( args.ArgC() != 2 || (V_stricmp( args[1], "plasma" ) && V_stricmp( args[1], "gravity" )) )
+	{
+		ClientPrint( pilot, HUD_PRINTCONSOLE, "Usage: abaddon_mine_set <plasma|gravity>\n" );
+		return;
+	}
+	pilot->SetAbaddonMineType( !V_stricmp( args[1], "gravity" ) );
+	pilot->PrintAbaddonArsenal();
+}
+
+void CHL2_Player::DropAbaddonMine()
+{
+	const float now = gpGlobals->curtime;
+	float energy = m_flAbaddonEnergy.Get();
+	abaddon::MineFeed bay = {m_nAbaddonMines.Get(), m_flAbaddonMineReady};
+	const abaddon::MineType kind = m_bAbaddonGravityMine ? abaddon::GravityMine : abaddon::PlasmaMine;
+	if ( !bay.Ready( now, energy, kind ) )
+		return;
+	Vector forward, right, up;
+	AngleVectors( EyeAngles(), &forward, &right, &up );
+	const Vector center = WorldSpaceCenter();
+	const abaddon::FlightBasis basis = {AbaddonOffset( forward ), AbaddonOffset( right ), AbaddonOffset( up )};
+	const abaddon::Vec3 point = abaddon::MineReleasePoint( AbaddonOffset( center ), basis );
+	const Vector origin( point.x, point.y, point.z );
+	if ( !AbaddonClearance( center, origin, abaddon::MineHull, this ) || !CAbaddonMine::Deploy( this, origin, kind ) )
+		return;
+	bay.Fired( now, energy, kind );
+	m_flAbaddonEnergy = energy;
+	m_nAbaddonMines = bay.reserve;
+	m_flAbaddonMineReady = bay.readyAt;
+	EmitSound( "Weapon_PhysCannon.Drop" );
+}
+
+void CHL2_Player::FireAbaddonMounts( int buttons )
+{
+	static const int mountButtons[abaddon::MountCount] = {IN_ATTACK, IN_ATTACK2, IN_GRENADE1, IN_GRENADE2};
+	const float now = gpGlobals->curtime;
+	abaddon::PlasmaFeed feed = ReadAbaddonPlasma();
+	feed.Advance( now, gpGlobals->frametime );
+	WriteAbaddonPlasma( feed );
+	if ( !( buttons & ( IN_ATTACK | IN_ATTACK2 | IN_GRENADE1 | IN_GRENADE2 ) ) )
+		return;
+
+	Vector forward, right, up;
+	AngleVectors( EyeAngles(), &forward, &right, &up );
+	const Vector center = WorldSpaceCenter();
+	const Vector eye = EyePosition();
+	const abaddon::FlightBasis basis = {AbaddonOffset( forward ), AbaddonOffset( right ), AbaddonOffset( up )};
+	trace_t aim;
+	UTIL_TraceLine( eye, eye + forward * abaddon::MountRange, MASK_SHOT, this, COLLISION_GROUP_NONE, &aim );
+	const Vector aimPoint = eye + forward * MAX( aim.fraction * abaddon::MountRange, 96.0f );
+	const AbaddonBoltSpec kinetic = {ABADDON_BOLT_KINETIC, abaddon::MountDamage, 0.0f, 0.0f, 3.0f, abaddon::MountRange, 5.0f};
+	const AbaddonBoltSpec plasmaBolt = {ABADDON_BOLT_PLASMA, 45.0f, 25.0f, 120.0f, 8.0f, abaddon::MountRange, 5.0f};
+	const Vector drift = GetAbsVelocity();
+
+	// The server publishes the muzzle event only after allocating a physical bolt.
+	CDisablePredictionFiltering sendToOwner;
+	for ( int i = 0; i < abaddon::MountCount; ++i )
+	{
+		abaddon::MountCycle &cycle = m_abaddonMounts[i];
+		const bool plasma = i == m_nAbaddonPlasmaMount.Get();
+		if ( !( buttons & mountButtons[i] ) || ( plasma && !feed.Ready( now ) ) || !cycle.BeginAttempt( now ) )
+			continue;
+
+		const AbaddonBoltSpec &spec = plasma ? plasmaBolt : kinetic;
+		const int socket = plasma ? 0 : cycle.socket;
+		const abaddon::MountGeometry geometry = abaddon::GetMountGeometry( AbaddonOffset( center ), basis, i, socket, plasma );
+		const Vector mount( geometry.mount.x, geometry.mount.y, geometry.mount.z );
+		const Vector muzzle( geometry.muzzle.x, geometry.muzzle.y, geometry.muzzle.z );
+		if ( !AbaddonClearance( center, mount, spec.hullRadius, this ) || !AbaddonClearance( mount, muzzle, spec.hullRadius, this ) )
+		{
+			if ( abaddon_mount_trace.GetBool() )
+				Msg( "ABADDON_MOUNT blocked mount=%d socket=%d time=%.3f\n", i + 1, socket + 1, now );
+			continue;
+		}
+
+		Vector direction = aimPoint - muzzle;
+		VectorNormalize( direction );
+		const Vector velocity = direction * ( plasma ? abaddon::PlasmaSpeed : abaddon::PulseSpeed ) + drift;
+		const unsigned int sequence = m_nAbaddonShotSequence + 1;
+		if ( !AbaddonLaunchBolt( this, muzzle, velocity, spec, sequence ) )
+			continue;
+
+		m_nAbaddonShotSequence = sequence;
+		if ( plasma )
+		{
+			feed.Fired( now );
+			WriteAbaddonPlasma( feed );
+		}
+		else
+		{
+			cycle.Fired();
+		}
+
+		CEffectData shot;
+		shot.m_vStart = muzzle;
+		shot.m_vOrigin = muzzle;
+		shot.m_vNormal = direction;
+		shot.m_fFlags = (i + 1) | (plasma ? abaddon::PlasmaShotFlag : 0);
+		shot.m_nHitBox = socket + 1;
+		shot.m_nDamageType = sequence;
+		shot.m_flScale = now;
+		CSingleUserRecipientFilter owner( this );
+		DispatchEffect( "AbaddonMountShot", shot, owner );
+		EmitSound( owner, SOUND_FROM_WORLD, plasma ? "Weapon_AR2.Single" : "Weapon_SMG1.Single", &muzzle );
+		if ( abaddon_mount_trace.GetBool() )
+			Msg( "ABADDON_MOUNT shot mount=%d socket=%d seq=%u kind=%s time=%.3f muzzle=%.2f,%.2f,%.2f\n",
+				i + 1, socket + 1, sequence, plasma ? "plasma" : "kinetic", now, muzzle.x, muzzle.y, muzzle.z );
+	}
+}
