+void CHL2_Player::ResetAbaddonMounts()
+{
+	for ( int i = 0; i < abaddon::MountCount; ++i )
+		m_abaddonMounts[i] = abaddon::MountCycle();
+	m_nAbaddonShotSequence = 0;
+}
+
+static abaddon::Vec3 AbaddonOffset( const Vector &vec )
+{
+	return abaddon::Vec3( vec.x, vec.y, vec.z );
+}
+
+static bool AbaddonClearance( const Vector &start, const Vector &end, CHL2_Player *pilot )
+{
+	trace_t trace;
+	UTIL_TraceLine( start, end, MASK_SHOT, pilot, COLLISION_GROUP_NONE, &trace );
+	return !trace.DidHit();
+}
+
+void CHL2_Player::FireAbaddonMounts( int buttons )
+{
+	static const int mountButtons[abaddon::MountCount] = {IN_ATTACK, IN_ATTACK2, IN_GRENADE1, IN_GRENADE2};
+	if ( !( buttons & ( IN_ATTACK | IN_ATTACK2 | IN_GRENADE1 | IN_GRENADE2 ) ) )
+		return;
+
+	Vector forward, right, up;
+	AngleVectors( EyeAngles(), &forward, &right, &up );
+	const Vector center = WorldSpaceCenter();
+	const Vector eye = EyePosition();
+	const abaddon::FlightBasis basis = {AbaddonOffset( forward ), AbaddonOffset( right ), AbaddonOffset( up )};
+	trace_t aim;
+	UTIL_TraceLine( eye, eye + forward * abaddon::MountRange, MASK_SHOT, this, COLLISION_GROUP_NONE, &aim );
+	const Vector aimPoint = eye + forward * MAX( aim.fraction * abaddon::MountRange, 96.0f );
+	const float now = gpGlobals->curtime;
+
+	// Damage and presentation come from the same server shot, with no predicted stock shot.
+	CDisablePredictionFiltering sendToOwner;
+	for ( int i = 0; i < abaddon::MountCount; ++i )
+	{
+		abaddon::MountCycle &cycle = m_abaddonMounts[i];
+		if ( !( buttons & mountButtons[i] ) || !cycle.BeginAttempt( now ) )
+			continue;
+
+		const int socket = cycle.socket;
+		const abaddon::MountGeometry geometry = abaddon::GetMountGeometry( AbaddonOffset( center ), basis, i, socket );
+		const Vector mount( geometry.mount.x, geometry.mount.y, geometry.mount.z );
+		const Vector muzzle( geometry.muzzle.x, geometry.muzzle.y, geometry.muzzle.z );
+		if ( !AbaddonClearance( center, mount, this ) || !AbaddonClearance( mount, muzzle, this ) )
+		{
+			if ( abaddon_mount_trace.GetBool() )
+				Msg( "ABADDON_MOUNT blocked mount=%d socket=%d time=%.3f\n", i + 1, socket + 1, now );
+			continue;
+		}
+
+		Vector direction = aimPoint - muzzle;
+		VectorNormalize( direction );
+		trace_t hit;
+		UTIL_TraceLine( muzzle, muzzle + direction * abaddon::MountRange, MASK_SHOT, this, COLLISION_GROUP_NONE, &hit );
+		if ( hit.startsolid || hit.allsolid )
+			continue;
+
+		cycle.Fired();
+		const unsigned int sequence = ++m_nAbaddonShotSequence;
+		if ( hit.DidHit() )
+		{
+			UTIL_ImpactTrace( &hit, DMG_BULLET );
+			if ( hit.m_pEnt && !hit.DidHitWorld() )
+			{
+				ClearMultiDamage();
+				CTakeDamageInfo damage( this, this, abaddon::MountDamage, DMG_BULLET | DMG_NEVERGIB );
+				damage.SetDamageForce( direction * 1500.0f );
+				damage.SetDamagePosition( hit.endpos );
+				hit.m_pEnt->DispatchTraceAttack( damage, direction, &hit );
+				ApplyMultiDamage();
+			}
+		}
+
+		// This named effect represents weapon_d6_mg/hitscan. The client uses the
+		// same world line for flash and tracer without a viewmodel attachment.
+		CEffectData shot;
+		shot.m_vStart = muzzle;
+		shot.m_vOrigin = hit.endpos;
+		shot.m_vNormal = direction;
+		shot.m_fFlags = i + 1;
+		shot.m_nHitBox = socket + 1;
+		shot.m_nDamageType = sequence;
+		shot.m_flScale = now;
+		CSingleUserRecipientFilter owner( this );
+		DispatchEffect( "AbaddonMGShot", shot, owner );
+		EmitSound( owner, SOUND_FROM_WORLD, "Weapon_SMG1.Single", &muzzle );
+		if ( abaddon_mount_trace.GetBool() )
+			Msg( "ABADDON_MOUNT shot mount=%d socket=%d seq=%u time=%.3f muzzle=%.2f,%.2f,%.2f hit=%d\n",
+				i + 1, socket + 1, sequence, now, muzzle.x, muzzle.y, muzzle.z, hit.DidHit() );
+	}
+}
