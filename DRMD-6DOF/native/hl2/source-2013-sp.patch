+void CHL2_Player::ResetAbaddonMounts()
+{
+	for ( int i = 0; i < abaddon::MountCount; ++i )
+		m_abaddonMounts[i] = abaddon::MountCycle();
+}
+
+void CHL2_Player::ResetAbaddonArsenal()
+{
+	// The upper mount starts with the single plasma module. Other ports use MG.
+	m_nAbaddonPlasmaMount = 2;
+	ResetAbaddonMineBay();
+	const abaddon::PlasmaFeed initial = {abaddon::FlightEnergyMax, 0.0f, abaddon::PlasmaCapacity};
+	WriteAbaddonPlasma( initial );
+}
+
+abaddon::PlasmaFeed CHL2_Player::ReadAbaddonPlasma() const
+{
