+void CHL2GameMovement::PlayerMove()
+{
+	if ( !GetHL2Player()->IsAbaddonFlightEnabled() || IsDead() || player->IsObserver() ||
+		player->IsInAVehicle() || player->GetMoveParent() || player->GetMoveType() != MOVETYPE_WALK ||
+		( player->GetFlags() & ( FL_FROZEN | FL_ONTRAIN ) ) )
+	{
+		BaseClass::PlayerMove();
+		return;
+	}
+
+	mv->m_outWishVel.Init();
+	mv->m_outJumpVel.Init();
+	MoveHelper()->ResetTouchList();
+	ReduceTimers();
+	SetGroundEntity( NULL );
+	player->m_Local.m_flFallVelocity = 0.0f;
+	CheckWater();
+	if ( CheckInterval( STUCK ) && CheckStuck() )
+		return;
+
+	Vector forward, right, up;
+	AngleVectors( mv->m_vecAbsViewAngles, &forward, &right, &up );
+	const abaddon::FlightBasis basis = {
+		abaddon::Vec3( forward.x, forward.y, forward.z ),
+		abaddon::Vec3( right.x, right.y, right.z ),
+		abaddon::Vec3( up.x, up.y, up.z ),
+	};
+	const float thrust = float( !!( mv->m_nButtons & IN_FORWARD ) - !!( mv->m_nButtons & IN_BACK ) );
+	const float slide = float( !!( mv->m_nButtons & IN_MOVERIGHT ) - !!( mv->m_nButtons & IN_MOVELEFT ) );
+	const float lift = float( !!( mv->m_nButtons & IN_JUMP ) - !!( mv->m_nButtons & IN_DUCK ) );
+	const abaddon::Vec3 wish = abaddon::FlightWish( basis, thrust, slide, lift );
+	const Vector &velocity = mv->m_vecVelocity;
+	const abaddon::Vec3 next = abaddon::StepFlight( abaddon::Vec3( velocity.x, velocity.y, velocity.z ),
+		wish, gpGlobals->frametime );
+	mv->m_vecVelocity.Init( next.x, next.y, next.z );
+	// The camera and movement basis can roll freely; Source's normal player hull stays upright.
+	mv->m_vecAngles.Init( 0.0f, mv->m_vecViewAngles[YAW], 0.0f );
+
+	CheckVelocity();
+	TryPlayerMove();
+	CheckVelocity();
+}
