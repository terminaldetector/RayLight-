+bool CHL2_Player::CanAbaddonFly()
+{
+	return gpGlobals->maxClients == 1 && IsAlive() && !IsObserver() &&
+		GetMoveType() == MOVETYPE_WALK && !IsInAVehicle() && !GetMoveParent() &&
+		!IsDucked() && !IsDucking() && !( GetFlags() & ( FL_FROZEN | FL_ONTRAIN ) ) &&
+		!( m_afPhysicsFlags & PFLAG_ONBARNACLE );
+}
+
+void CHL2_Player::SetAbaddonFlightEnabled( bool enabled )
+{
+	if ( IsAbaddonFlightEnabled() == enabled || ( enabled && !CanAbaddonFly() ) )
+		return;
+	m_bAbaddonFlight = enabled;
+	m_Local.m_flFallVelocity = 0.0f;
+	if ( !enabled && IsAlive() && GetMoveType() == MOVETYPE_WALK && !IsInAVehicle() && !GetMoveParent() )
+	{
+		SetAbsVelocity( vec3_origin );
+		QAngle level = LocalEyeAngles();
+		level[PITCH] = clamp( AngleNormalize( level[PITCH] ), -89.0f, 89.0f );
+		level[ROLL] = 0.0f;
+		SnapEyeAngles( level );
+	}
+}
+
+CON_COMMAND( abaddon_flight, "Toggle experimental 6DOF flight in a standing single-player session" )
+{
+	CHL2_Player *pilot = dynamic_cast<CHL2_Player *>( UTIL_GetCommandClient() );
+	if ( !pilot )
+		return;
+	const bool enable = !pilot->IsAbaddonFlightEnabled();
+	if ( enable && !pilot->CanAbaddonFly() )
+	{
+		ClientPrint( pilot, HUD_PRINTCONSOLE, "Abaddon: flight requires a live, standing single-player pilot.\n" );
+		return;
+	}
+	pilot->SetAbaddonFlightEnabled( enable );
+	ClientPrint( pilot, HUD_PRINTCONSOLE, enable ? "Abaddon 6DOF enabled.\n" : "Abaddon 6DOF disabled.\n" );
+}
+
+CON_COMMAND( abaddon_flight_status, "Print flight mode, position, velocity and view angles" )
+{
+	CHL2_Player *pilot = dynamic_cast<CHL2_Player *>( UTIL_GetCommandClient() );
+	if ( !pilot )
+		return;
+	const Vector &origin = pilot->GetAbsOrigin();
+	const Vector &velocity = pilot->GetAbsVelocity();
+	const QAngle &angles = pilot->LocalEyeAngles();
+	char status[192];
+	V_snprintf( status, sizeof( status ),
+		"ABADDON_FLIGHT %d pos %.1f %.1f %.1f vel %.1f %.1f %.1f ang %.1f %.1f %.1f\n",
+		pilot->IsAbaddonFlightEnabled() ? 1 : 0, origin.x, origin.y, origin.z,
+		velocity.x, velocity.y, velocity.z, angles.x, angles.y, angles.z );
+	ClientPrint( pilot, HUD_PRINTCONSOLE, status );
+}
